syntax = "v1"

info (
	title:   "旅游服务"
	desc:    "旅游服务"
	author:  "hwy"
	email:   "13858126467@163.com"
	version: "v1"
)

import (
	"homestay/homestay.api"
	"homestay/homestayComment.api"
	"homestay/homestayBusiness.api"
)

// 民宿信息
@server (
	prefix: travel/v1
	group:  homestay
)
service travel {
	@doc "homestay room list"
	@handler homestayList
	post /homestay/homestayList (HomestayListReq) returns (HomestayListResp)

	@doc "boss all homestay room"
	@handler businessList
	post /homestay/businessList (BusinessListReq) returns (BusinessListResp)

	@doc "guess homestay room"
	@handler guessList
	post /homestay/guessList (GuessListReq) returns (GuessListResp)

	@doc "homestay room detail"
	@handler homestayDetail
	get /homestay/homestay-detail (HomestayDetailReq) returns (HomestayDetailResp)

	@doc "homestay room eatra detail"
	@handler homestayExtraDetail
	get /homestay/homestay-extra-detail (HomestayDetailReq) returns (HomestayDetailResp)

	@doc "homestay room common list"
	@handler homestayCommentList
	get /homestay/homestay-comment-list (HomestayCommentListReq) returns (HomestayCommentListResp)

	@doc "根据民宿ID查询：房东信息"
	@handler homestayBusinessInfoWithHomeStayId
	get /homestay/homestay-bussiness-info/with-homestay-id (HomestayBusinessInfoWithHomeStayIdReq) returns (HomestayBusinessInfoResp)

	@doc "根据房东信息ID查询：房东信息"
	@handler homestayBusinessInfoWithId
	get /homestay/homestay-bussiness-info/with-id (HomestayBusinessInfoWithIdReq) returns (HomestayBusinessInfoResp)
}

@server (
	prefix: travel/v1
	group:  homestay
	jwt:    JwtAuth
)
service travel {
	@doc "创建评价"
	@handler homestayCommentCreate
	post /homestay/comment/create (HomestayCommentCreateReq) returns (HomestayBusinessInfoResp)
}

